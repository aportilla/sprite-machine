{
  "name": "sprite-machine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turn low-res pixel sprites (face views) into Three.js 3D objects.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "vite": "8.1.5"
  },
  "dependencies": {
    "three": "0.185.1"
  }
}
