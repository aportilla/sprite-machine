{
  "name": "sprite-machine-app",
  "private": true,
  "version": "0.2.17",
  "type": "module",
  "description": "Turn low-res pixel sprites (face views) into Three.js 3D objects — the System 7 desktop app over the sprite-machine engine.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.mjs packages/core/test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/core/tsconfig.json",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "vite": "8.1.5"
  },
  "dependencies": {
    "lit": "^3.3.0",
    "three": "0.185.1",
    "vintage-frames": "^0.10.1"
  }
}
